{
  "namespace": "seatalk",
  "version": 1,
  "title": "SeaTalk bridge",
  "description": "SeaTalk 1 to Signal K bridge. Mode per datagram type: off = nothing; to_sk = bus to Signal K only; to_bus = Signal K to bus only; both = both directions, no check for other devices; auto = bus to Signal K always, Signal K to bus only while no other bus device has sent this type in the last 10 s. Send period: 0 = never. Sources: only take this Signal K $source (empty = any except this device).",
  "keys": [
    {"name": "idle_us", "type": "int", "default": 30000, "min": 20000, "max": 100000, "unit": "ms", "x": {"displayMultiplier": 0.001}, "group": "General", "title": "Quiet bus before sending", "description": "The ST50 waits about 26 ms; do not go below 24 ms."},
    {"name": "jitter_us", "type": "int", "default": 4000, "min": 0, "max": 20000, "unit": "ms", "x": {"displayMultiplier": 0.001}, "group": "General", "title": "Random extra wait", "description": "Random 0 to this added to the quiet wait, so two devices do not start together."},
    {"name": "stale_ms", "type": "int", "default": 5000, "min": 1000, "max": 60000, "unit": "ms", "group": "General", "title": "Value timeout", "description": "Older Signal K values are not sent; the display blanks instead of showing an old number."},
    {"name": "mag_fallback", "type": "bool", "default": true, "group": "General", "title": "Magnetic from true", "description": "Without fresh magnetic heading/COG, use true minus magneticVariation."},
    {"name": "leds", "type": "bool", "default": true, "group": "General", "title": "RX/TX lights", "description": "Bus activity lights on or off, on boards with an enable pin (SuperMini wiring: GPIO11)."},
    {"name": "stw_from_sog", "type": "string", "default": "off", "enum": ["off", "fallback", "replace"], "group": "Substitutes", "title": "Boat speed from SOG", "description": "Send SOG as boat speed (20). fallback = only while speedThroughWater is stale; replace = always. A log on the bus still wins in auto mode."},
    {"name": "hdg_from_cog", "type": "string", "default": "off", "enum": ["off", "fallback", "replace"], "group": "Substitutes", "title": "Heading from COG", "description": "Send COG as heading (89/9C). fallback = only while heading is stale; replace = always. Unreliable at low speed. A compass on the bus still wins in auto mode."},
    {"name": "m_00", "type": "string", "default": "auto", "enum": ["off", "to_sk", "to_bus", "both", "auto"], "group": "00 depth", "title": "Mode"},
    {"name": "p_00", "type": "int", "default": 1000, "min": 0, "max": 60000, "unit": "ms", "group": "00 depth", "title": "Send period"},
    {"name": "m_10", "type": "string", "default": "auto", "enum": ["off", "to_sk", "to_bus", "both", "auto"], "group": "10 wind_angle", "title": "Mode"},
    {"name": "p_10", "type": "int", "default": 500, "min": 0, "max": 60000, "unit": "ms", "group": "10 wind_angle", "title": "Send period"},
    {"name": "m_11", "type": "string", "default": "auto", "enum": ["off", "to_sk", "to_bus", "both", "auto"], "group": "11 wind_speed", "title": "Mode"},
    {"name": "p_11", "type": "int", "default": 500, "min": 0, "max": 60000, "unit": "ms", "group": "11 wind_speed", "title": "Send period"},
    {"name": "m_20", "type": "string", "default": "auto", "enum": ["off", "to_sk", "to_bus", "both", "auto"], "group": "20 stw", "title": "Mode"},
    {"name": "p_20", "type": "int", "default": 1000, "min": 0, "max": 60000, "unit": "ms", "group": "20 stw", "title": "Send period"},
    {"name": "m_21", "type": "string", "default": "auto", "enum": ["off", "to_sk", "to_bus", "both", "auto"], "group": "21 trip", "title": "Mode"},
    {"name": "p_21", "type": "int", "default": 0, "min": 0, "max": 60000, "unit": "ms", "group": "21 trip", "title": "Send period"},
    {"name": "m_22", "type": "string", "default": "auto", "enum": ["off", "to_sk", "to_bus", "both", "auto"], "group": "22 total_log", "title": "Mode"},
    {"name": "p_22", "type": "int", "default": 0, "min": 0, "max": 60000, "unit": "ms", "group": "22 total_log", "title": "Send period"},
    {"name": "m_23", "type": "string", "default": "auto", "enum": ["off", "to_sk", "to_bus", "both", "auto"], "group": "23 water_temp_int", "title": "Mode"},
    {"name": "p_23", "type": "int", "default": 0, "min": 0, "max": 60000, "unit": "ms", "group": "23 water_temp_int", "title": "Send period"},
    {"name": "m_25", "type": "string", "default": "auto", "enum": ["off", "to_sk", "to_bus", "both", "auto"], "group": "25 log", "title": "Mode"},
    {"name": "p_25", "type": "int", "default": 5000, "min": 0, "max": 60000, "unit": "ms", "group": "25 log", "title": "Send period"},
    {"name": "m_26", "type": "string", "default": "auto", "enum": ["off", "to_sk", "to_bus", "both", "auto"], "group": "26 stw_precise", "title": "Mode"},
    {"name": "p_26", "type": "int", "default": 0, "min": 0, "max": 60000, "unit": "ms", "group": "26 stw_precise", "title": "Send period"},
    {"name": "m_27", "type": "string", "default": "auto", "enum": ["off", "to_sk", "to_bus", "both", "auto"], "group": "27 water_temp", "title": "Mode"},
    {"name": "p_27", "type": "int", "default": 5000, "min": 0, "max": 60000, "unit": "ms", "group": "27 water_temp", "title": "Send period"},
    {"name": "m_30", "type": "string", "default": "auto", "enum": ["off", "to_sk", "to_bus", "both", "auto"], "group": "30 lamp", "title": "Mode"},
    {"name": "m_52", "type": "string", "default": "auto", "enum": ["off", "to_sk", "to_bus", "both", "auto"], "group": "52 sog", "title": "Mode"},
    {"name": "p_52", "type": "int", "default": 1000, "min": 0, "max": 60000, "unit": "ms", "group": "52 sog", "title": "Send period"},
    {"name": "m_53", "type": "string", "default": "auto", "enum": ["off", "to_sk", "to_bus", "both", "auto"], "group": "53 cog", "title": "Mode"},
    {"name": "p_53", "type": "int", "default": 1000, "min": 0, "max": 60000, "unit": "ms", "group": "53 cog", "title": "Send period"},
    {"name": "m_89", "type": "string", "default": "auto", "enum": ["off", "to_sk", "to_bus", "both", "auto"], "group": "89 compass", "title": "Mode"},
    {"name": "p_89", "type": "int", "default": 1000, "min": 0, "max": 60000, "unit": "ms", "group": "89 compass", "title": "Send period"},
    {"name": "m_9c", "type": "string", "default": "auto", "enum": ["off", "to_sk", "to_bus", "both", "auto"], "group": "9C heading_rudder", "title": "Mode"},
    {"name": "p_9c", "type": "int", "default": 0, "min": 0, "max": 60000, "unit": "ms", "group": "9C heading_rudder", "title": "Send period"},
    {"name": "src_depth", "type": "string", "default": "", "maxLength": 64, "group": "Sources", "title": "Source for depth"},
    {"name": "src_awa", "type": "string", "default": "", "maxLength": 64, "group": "Sources", "title": "Source for apparent wind angle"},
    {"name": "src_aws", "type": "string", "default": "", "maxLength": 64, "group": "Sources", "title": "Source for apparent wind speed"},
    {"name": "src_stw", "type": "string", "default": "", "maxLength": 64, "group": "Sources", "title": "Source for speed through water"},
    {"name": "src_trip", "type": "string", "default": "", "maxLength": 64, "group": "Sources", "title": "Source for trip log"},
    {"name": "src_log", "type": "string", "default": "", "maxLength": 64, "group": "Sources", "title": "Source for total log"},
    {"name": "src_wtemp", "type": "string", "default": "", "maxLength": 64, "group": "Sources", "title": "Source for water temperature"},
    {"name": "src_sog", "type": "string", "default": "", "maxLength": 64, "group": "Sources", "title": "Source for speed over ground"},
    {"name": "src_cog", "type": "string", "default": "", "maxLength": 64, "group": "Sources", "title": "Source for course over ground (magnetic)"},
    {"name": "src_hdg", "type": "string", "default": "", "maxLength": 64, "group": "Sources", "title": "Source for heading (magnetic)"},
    {"name": "src_rudder", "type": "string", "default": "", "maxLength": 64, "group": "Sources", "title": "Source for rudder angle"}
  ]
}
